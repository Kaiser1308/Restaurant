{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=restaurant_db;Username=restaurant_user;Password=restaurant_pass"
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "restaurant_minio",
    "SecretKey": "restaurant_minio_password",
    "BucketName": "restaurant-images",
    "UseSsl": false,
    "PresignedUrlTtlMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
